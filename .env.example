# ============================================================
# VARANASI — Autonomous GPU RunGuard & FinOps Margin Engine
# Nebius × NVIDIA Global AI Hackathon 2026 Environment Config
# ============================================================

# Nebius Token Factory API Configuration
# Get your API key from https://tokenfactory.nebius.com or https://studio.nebius.ai
NEBIUS_API_KEY=your_nebius_api_key_here
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
# Eligible NVIDIA Open-Source Model on Nebius Token Factory
NEBIUS_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B

# Tavily AI Search API Configuration
# Get your API key from https://tavily.com
TAVILY_API_KEY=your_tavily_api_key_here

# Cloudflare Turnstile Verification Configuration
# Get your keys from Cloudflare Dashboard -> Turnstile
# Public Site Key (accessible by client frontend; e.g. 0x4AAAAAA... or testing key 1x00000000000000000000AA)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Secret Key (server-side verification only, never exposed to client; e.g. 0x4AAAAAA... or testing key 1x0000000000000000000000000000000AA)
TURNSTILE_SECRET_KEY=

# Allowed Hostnames (comma-separated whitelist for hostname verification)
TURNSTILE_ALLOWED_HOSTNAMES=localhost,127.0.0.1,varanasi-nvidia-x-nebius.vercel.app

# Optional Durable Rate Limiting (Upstash Redis / Vercel KV)
# If omitted, server falls back to single-instance in-memory sliding window
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Application Metadata
NEXT_PUBLIC_APP_NAME="VARANASI — Autonomous GPU RunGuard & FinOps Margin Engine"
NEXT_PUBLIC_APP_VERSION="1.0.0"
